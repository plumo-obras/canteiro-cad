{
  "openapi": "3.1.0",
  "info": {
    "title": "Tradutor de pranchas estruturais",
    "description": "Lê pranchas de cálculo estrutural (PDF do CAD ou imagem) e devolve os dados estruturados e o modelo 3D do esqueleto estrutural. Contrato de saída versão 1.0.",
    "version": "1.2.0"
  },
