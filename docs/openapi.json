              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projetos/espelho.dxf": {
      "get": {
        "tags": [
          "projeto"
        ],
        "summary": "Espelho Dxf",
        "description": "O modelo do pacote em DXF para editar no CAD (CADCraft, AutoCAD...). Se o pacote já tem uma edição do CAD,\no espelho sai com ela aplicada: dá para editar, subir, baixar de novo e continuar.",
        "operationId": "espelho_dxf_v1_projetos_espelho_dxf_get",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
